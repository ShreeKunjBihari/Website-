# Shree Khunj Bihari Enterprises - Backend Environment Variables
# Copy this file to .env (or enter these in your hosting dashboard) and fill in real values.
# NEVER commit or share the real .env file.

NODE_ENV=production

# Your public website address, no trailing slash. Used for sitemap.xml, robots.txt
# and the www -> non-www redirect. Use whichever version you want Google to show.
SITE_URL=https://skunj.com

# Database (use a dedicated limited user, not "postgres")
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skb_website
DB_USER=skb_app
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# true  = database requires SSL (Neon, Supabase, Render Postgres, RDS ...)
# false = database is on the same server as the website (localhost)
# If left out: SSL is used in production unless DB_HOST is localhost.
DB_SSL=false

# Server
PORT=3000

# Number of reverse proxies in front of Node (Render/Railway/Nginx = 1).
# Needed so the rate limiter sees real visitor IPs.
TRUST_PROXY_HOPS=1

# CORS - only needed if the frontend is hosted on a DIFFERENT domain than this server.
ALLOWED_ORIGINS=https://skunj.com,https://www.skunj.com
